# Navegador. Nunca pongas aquí la clave de servicio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor y scripts de semilla.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Semilla de entrenadores. No escribas correos en el código.
ENTRENADOR_1_CORREO=
ENTRENADOR_1_NOMBRE=Yohan
ENTRENADOR_1_ETIQUETA=Entrenador certificado
ENTRENADOR_2_CORREO=
ENTRENADOR_2_NOMBRE=Alfredo
ENTRENADOR_2_ETIQUETA=Entrenador en formación

# Transferencia. Mientras estén vacíos se muestra [POR DEFINIR].
NEXT_PUBLIC_TRANSFERENCIA_BANCO=
NEXT_PUBLIC_TRANSFERENCIA_CLABE=
NEXT_PUBLIC_TRANSFERENCIA_TITULAR=

# WhatsApp: solo dígitos con código de país.
NEXT_PUBLIC_WHATSAPP_VENTAS=
NEXT_PUBLIC_WHATSAPP_YOHAN=
NEXT_PUBLIC_WHATSAPP_ALFREDO=

# URL pública de esta app (redirecciones de Auth).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron de retención. Vercel Cron manda Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# SMTP propio (Resend u otro). Sin esto, la retención no borra cuentas.
SMTP_CONFIGURADO=false
